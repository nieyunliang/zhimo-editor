{
  "name": "zhimo-editor",
  "version": "0.1.0",
  "description": "知墨编辑器：基于 TipTap v3 的 React 富文本编辑器组件",
  "license": "MIT",
  "author": "nieyunliang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nieyunliang/zhimo-editor.git"
  },
  "homepage": "https://github.com/nieyunliang/zhimo-editor#readme",
  "bugs": {
    "url": "https://github.com/nieyunliang/zhimo-editor/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "editor",
    "rich-text-editor",
    "wysiwyg",
    "wysiwyg-editor",
    "tiptap",
    "prosemirror",
    "zhimo"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/zhimo-editor.js",
  "module": "./dist/zhimo-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zhimo-editor.js"
    },
    "./styles.css": "./dist/zhimo-editor.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:css": "tailwindcss -i src/editor/styles/index.css -o dist/zhimo-editor.css --minify",
    "build:dist": "npm run build:lib && npm run build:css",
    "prepare": "npm run build:dist",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "lucide-react": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.33.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
